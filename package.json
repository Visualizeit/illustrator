    "oxlint": "1.74.0",
    "oxlint-tsgolint": "0.25.0",
    "typescript": "6.0.3",
    "ultracite": "7.9.4",
    "vitest": "4.1.10"
  },
  "packageManager": "pnpm@11.9.0"
