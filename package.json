{
  "name": "illustrator",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "check": "ultracite check",
    "check:themes": "node scripts/validate-themes.mjs",
    "fix": "ultracite fix",
    "pretest": "npm --prefix skills/illustrator ls --omit=dev --depth=0 || npm --prefix skills/illustrator ci --omit=dev --no-audit --no-fund",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "validate": "pnpm run check && pnpm run typecheck && pnpm run check:themes && pnpm run test"
  },
  "dependencies": {
    "@takumi-rs/core": "2.17.1",
    "takumi-js": "2.17.1"
  },
  "devDependencies": {
    "@pierre/highlights": "0.2.0",
    "@total-typescript/tsconfig": "1.0.4",
    "@types/node": "26.1.1",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "oxlint-tsgolint": "7.0.2005",
    "typescript": "6.0.3",
    "ultracite": "8.0.2",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "packageManager": "pnpm@11.9.0"
}
